types="fix|config|feat|feat-rm|update|experimental|chore|style|content|misc"

pattern="^($types)(\+($types))*: .+"

commit_msg=$(cat "$1")

if [[ ! $commit_msg =~ $pattern ]]; then
  echo "--------------------------------------------------------"
  echo "❌ INVALID COMMIT FORMAT"
  echo "Expected: <type>: <summary>  OR  <type>+<type>: <summary>"
  echo "Allowed: $types"
  echo "--------------------------------------------------------"
  exit 1
fi
