{
	"linter": { "rules": { "recommended": true } },
	"formatter": { "enabled": true },
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": { "enabled": true },
		"linter": { "enabled": true }
	},
	"css": {
		"formatter": { "enabled": true },
		"linter": { "enabled": true }
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off",
						"noUnknownPseudoClass": "off",
						"noUnknownFunction": "off"
					}
				}
			}
		}
	]
}
