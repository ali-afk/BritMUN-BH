{
	"name": "main",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky && svelte-kit sync",
		"fix": "biome check --fix --staged --no-errors-on-unmatched",
		"fix-all": "biome check --fix --no-errors-on-unmatched ./src && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.12",
		"@netlify/plugin-lighthouse": "^6.0.4",
		"@sveltejs/adapter-netlify": "^5.2.4",
		"@sveltejs/kit": "^2.50.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"bezier-easing": "^2.1.0",
		"husky": "^9.1.7",
		"lightningcss": "^1.31.1",
		"netlify-cli": "^23.13.5",
		"svelte": "^5.48.2",
		"svelte-check": "^4.3.5",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@fontsource/average": "^5.2.8",
		"@fontsource/girassol": "^5.2.8"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"esbuild",
		"netlify-cli",
		"puppeteer",
		"sharp",
		"unix-dgram"
	]
}
